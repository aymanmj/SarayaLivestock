{
	admin off
	http_port 18080
	https_port 18443
	skip_install_trust
}

https://{$SARAYA_OFFLINE_HOST:saraya.local}:18443 {
	tls internal

	encode zstd gzip

	@api path /api/*
	handle @api {
		reverse_proxy localhost:4000
	}

	handle {
		root * "{$SARAYA_WEB_ROOT}"
		try_files {path} /index.html
		file_server
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'"
	}

	log {
		output file "{$SARAYA_LOG_DIR}/caddy-access.log" {
			roll_size 10mb
			roll_keep 5
		}
		format json
	}
}
