# =============================================================================
# Saraya Livestock Server Configuration
# Generated by Saraya Livestock Server Installer
# WARNING: This file contains secrets. Do not share or commit to source control.
# =============================================================================

# Database
DATABASE_URL="postgresql://saraya:{{DB_PASSWORD}}@localhost:5435/{{DB_NAME}}?schema=public"
DB_USER=saraya
DB_PASSWORD={{DB_PASSWORD}}
DB_NAME={{DB_NAME}}
DB_PORT=5435
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000

# Database Lifecycle (do not change unless performing a maintenance operation)
SARAYA_DB_ENV=production

# JWT & Security
JWT_SECRET={{JWT_SECRET}}
JWT_EXPIRATION=15m
REFRESH_TOKEN_TTL_DAYS=30
IDEMPOTENCY_RETENTION_DAYS=7
ENCRYPTION_KEY={{ENCRYPTION_KEY}}
ALLOW_DEMO_SEED=false
CORS_ORIGINS=https://{{HOSTNAME}},null
ENABLE_SWAGGER=false
TRUST_PROXY_HOPS=1

# Customer Business Values
MILK_PRICE_PER_LITER=0
BEEF_MARKET_PRICE_PER_KG=0

# Initial Admin Provisioning (remove password after first run)
INITIAL_ORG_NAME={{INITIAL_ORG_NAME}}
INITIAL_FARM_NAME={{INITIAL_FARM_NAME}}
INITIAL_ADMIN_USERNAME={{INITIAL_ADMIN_USERNAME}}
INITIAL_ADMIN_FULL_NAME=مدير النظام
INITIAL_ADMIN_PASSWORD={{INITIAL_ADMIN_PASSWORD}}

# Server
PORT=4000
HOST=127.0.0.1
NODE_ENV=production
API_PREFIX=api/v1
SARAYA_DATA_DIR={{DATA_DIR}}
