}

/// Ø¬Ù„Ø³Ø© Ù‚Ø§Ø¨Ù„Ø© Ù„Ù„Ø¥Ø¨Ø·Ø§Ù„. Ù„Ø§ ÙŠÙØ®Ø²ÙŽÙ‘Ù† Ø±Ù…Ø² Ø§Ù„ØªØ­Ø¯ÙŠØ« Ø§Ù„Ø®Ø§Ù…Ø› tokenHash Ù‡Ùˆ SHA-256 ÙÙ‚Ø·.
model UserSession {
  id                  String                   @id @default(uuid())
  userId              String
  familyId            String                   @default(uuid())
  tokenHash           String                   @unique
  expiresAt           DateTime
  lastUsedAt          DateTime                 @default(now())
  revokedAt           DateTime?
  revocationReason    SessionRevocationReason?
  replacedBySessionId String?                  @unique
  ipAddress           String?
  userAgent           String?
  createdAt           DateTime                 @default(now())

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy UserSession? @relation("SessionRotation", fields: [replacedBySessionId], references: [id], onDelete: SetNull)
  replaces   UserSession? @relation("SessionRotation")

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("user_sessions")
}

/// Ø³Ø¬Ù„ Ø£Ø¯Ù„Ø© Ø£Ù…Ù†ÙŠ/ØªØ´ØºÙŠÙ„ÙŠ Ø¥Ù„Ø­Ø§Ù‚ÙŠ. Ø§Ù„Ù…Ø¹Ø±Ù‘ÙØ§Øª ØºÙŠØ± Ù…Ø±ØªØ¨Ø·Ø© Ø¨Ù…ÙØ§ØªÙŠØ­ Ø®Ø§Ø±Ø¬ÙŠØ© Ø¹Ù…Ø¯Ø§Ù‹
/// Ø­ØªÙ‰ ØªØ¨Ù‚Ù‰ Ø§Ù„Ø£Ø¯Ù„Ø© Ø§Ù„ØªØ§Ø±ÙŠØ®ÙŠØ© Ù…Ø­ÙÙˆØ¸Ø© Ø¹Ù†Ø¯ Ø­Ø°Ù Ø§Ù„ÙƒÙŠØ§Ù†Ø§Øª Ø§Ù„ØªØ´ØºÙŠÙ„ÙŠØ©.
model AuditEvent {
  id          String   @id @default(uuid())
  orgId       String
  farmId      String?
  actorUserId String
  action      String
  entityType  String
  entityId    String?
  httpMethod  String
