enum JournalEntryStatus {
  DRAFT
  POSTED
  VOIDED
}

model JournalEntry {
  id             String             @id @default(uuid())
  farmId         String
  fiscalYearId   String
  fiscalPeriodId String?
  entryNumber    String // Ù…Ø«Ø§Ù„: "JV-2026-0001"
  entryDate      DateTime           @db.Date
  type           JournalEntryType   @default(MANUAL)
  status         JournalEntryStatus @default(POSTED)
  description    String
  referenceId    String? // Ø±Ø¨Ø· Ø¨Ø±Ù‚Ù… Ø§Ù„Ø­Ù„Ø¨Ø© Ø£Ùˆ ØªØ´ØºÙŠÙ„Ø© Ø§Ù„Ø¹Ù„Ù Ø£Ùˆ Ø±Ù‚Ù… Ø§Ù„Ø¨Ù‚Ø±Ø©
  totalDebit     Decimal            @db.Decimal(18, 3)
  totalCredit    Decimal            @db.Decimal(18, 3)
  postedAt       DateTime?          @default(now())
  postedBy       String? // Ø§Ù„Ù…Ø³ØªØ®Ø¯Ù… Ø§Ù„Ø°ÙŠ Ø§Ø¹ØªÙ…Ø¯ Ø§Ù„Ù‚ÙŠØ¯
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  farm         Farm               @relation(fields: [farmId], references: [id], onDelete: Cascade)
  fiscalYear   FiscalYear         @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  fiscalPeriod FiscalPeriod?      @relation(fields: [fiscalPeriodId], references: [id], onDelete: SetNull)
  lines        JournalEntryLine[]
  commercialSales   CommercialSale[]
  animalMortalities AnimalMortality[]

  @@unique([farmId, entryNumber])
  @@map("journal_entries")
}

model JournalEntryLine {
  id             String  @id @default(uuid())
  journalEntryId String
  accountId      String
  costCenterId   String?
  animalId       String?
  debit          Decimal @default(0) @db.Decimal(18, 3)
  credit         Decimal @default(0) @db.Decimal(18, 3)
  memo           String?

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  costCenter   CostCenter?  @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  animal       Animal?     @relation(fields: [animalId], references: [id], onDelete: Restrict)

  @@index([animalId])
  @@map("journal_entry_lines")
}

model JournalSequence {
  id           String   @id @default(uuid())
  farmId       String
  fiscalYearId String
  nextNumber   Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  farm       Farm       @relation(fields: [farmId], references: [id], onDelete: Cascade)
  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  @@unique([farmId, fiscalYearId])
  @@map("journal_sequences")
}

// ----------------------------------------------------
// 8. Ø§Ù„Ù…Ø¨ÙŠØ¹Ø§Øª Ø§Ù„ØªØ¬Ø§Ø±ÙŠØ© ÙˆÙ†ÙÙˆÙ‚ Ø§Ù„Ø­ÙŠÙˆØ§Ù†Ø§Øª (Commercial Sales & Mortality)
// ----------------------------------------------------

enum SaleType {
  MILK
  LIVE_ANIMAL
}

enum PaymentMethod {
  CASH
  BANK
  ON_ACCOUNT
}

enum AnimalPricingMethod {
  BY_WEIGHT
  PER_HEAD
}

model CommercialSale {
  id            String               @id @default(uuid())
  farmId        String
  invoiceNumber String
  saleDate      DateTime             @default(now())
  saleType      SaleType
  paymentMethod PaymentMethod        @default(CASH)
  buyerName     String
  buyerPhone    String?
  notes         String?

  // ØªÙØ§ØµÙŠÙ„ Ø¨ÙŠØ¹ Ø§Ù„Ø­Ù„ÙŠØ¨ Ø§Ù„Ø®Ø§Ù…
  liters        Decimal?             @db.Decimal(12, 3)
  pricePerLiter Decimal?             @db.Decimal(10, 3)

  // ØªÙØ§ØµÙŠÙ„ Ø¨ÙŠØ¹ Ø§Ù„Ù…Ø§Ø´ÙŠØ© Ø§Ù„Ø­ÙŠØ©
  animalId      String?
  pricingMethod AnimalPricingMethod?
  weightKg      Decimal?             @db.Decimal(10, 3)
  pricePerKg    Decimal?             @db.Decimal(10, 3)
  pricePerHead  Decimal?             @db.Decimal(15, 3)

  // Ø§Ù„Ø¥Ø¬Ù…Ø§Ù„ÙŠØ§Øª Ø§Ù„Ù…Ø§Ù„ÙŠØ© ÙˆØ§Ù„Ø±Ø¨Ø· Ø§Ù„Ù…Ø­Ø§Ø³Ø¨ÙŠ
  totalAmount    Decimal       @db.Decimal(18, 3)
  journalEntryId String?
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  farm         Farm          @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animal       Animal?       @relation(fields: [animalId], references: [id], onDelete: SetNull)
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@unique([farmId, invoiceNumber])
  @@index([farmId, saleDate])
  @@index([farmId, saleType])
  @@map("commercial_sales")
}

model AnimalMortality {
  id             String   @id @default(uuid())
  farmId         String
  animalId       String
  deathDate      DateTime @db.Date
  causeOfDeath   String
  salvageValue   Decimal  @default(0) @db.Decimal(15, 3)
  bookValue      Decimal  @db.Decimal(15, 3)
  netLoss        Decimal  @db.Decimal(15, 3)
  notes          String?
  journalEntryId String?
  recordedById   String?
  createdAt      DateTime @default(now())

  farm         Farm          @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animal       Animal        @relation(fields: [animalId], references: [id], onDelete: Cascade)
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@index([farmId, deathDate])
  @@map("animal_mortalities")
}
