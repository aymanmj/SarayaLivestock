}

/// Ø³Ø¬Ù„ Ù…Ù†Ø¹ Ø§Ù„ØªÙƒØ±Ø§Ø± Ù„Ù„Ø·Ù„Ø¨Ø§Øª Ø§Ù„ØªØ´ØºÙŠÙ„ÙŠØ©. ÙŠÙÙ†Ø´Ø£ ÙˆÙŠÙØ³ØªÙƒÙ…Ù„ Ø¯Ø§Ø®Ù„ Ù…Ø¹Ø§Ù…Ù„Ø© Ø§Ù„Ø¹Ù…Ù„ÙŠØ© Ù†ÙØ³Ù‡Ø§.
model IdempotencyRecord {
  id             String            @id @default(uuid())
  orgId          String
  farmId         String?
  actorUserId    String
  key            String
  requestHash    String
  method         String
