// ----------------------------------------------------

enum PlanType {
  STANDARD
  ENTERPRISE
  ON_PREMISE
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  taxNumber String?
  phone     String?
  planType  PlanType @default(STANDARD)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farms Farm[]
  users User[]

  @@map("organizations")
}

model Farm {
  id          String   @id @default(uuid())
  orgId       String
  name        String
  location    String?
  managerName String?
  phone       String?
  timezone    String   @default("UTC")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization     Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  barns            Barn[]
  animals          Animal[]
  bulkTanks        BulkTankLog[]
  feedStock        FeedIngredient[]
  feedFormulas     FeedFormula[]
  costCenters      CostCenter[]
  users            User[]
  fiscalYears      FiscalYear[]
  accounts         Account[]
  journalEntries   JournalEntry[]
  journalSequences JournalSequence[]
  commercialSales   CommercialSale[]
  animalMortalities AnimalMortality[]
  milkPolicy        MilkInventoryPolicy @default(DAILY_RESET)
  milkPolicyEffectiveDate DateTime? @db.Date

  @@map("farms")
}

enum MilkInventoryPolicy {
  DAILY_RESET
  CARRY_OVER
}

enum SectorType {
  DAIRY
  FATTENING
  BREEDING
  CALVES
  ISOLATION
}

model Barn {
  id         String     @id @default(uuid())
  farmId     String
  name       String
  sectorType SectorType @default(DAIRY)
  capacity   Int        @default(50)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  farm              Farm               @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animals           Animal[]
  feedDistributions FeedDistribution[]

  @@unique([farmId, name])
  @@map("barns")
}

