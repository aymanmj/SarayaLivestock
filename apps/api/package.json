{
  "name": "@saraya/api",
  "version": "1.0.0",
  "private": true,
  "description": "سيرفر الواجهة الخلفية لمنظومة سرايا لإدارة الماشية والألبان - Saraya Livestock API",
  "author": "Saraya Team",
  "license": "UNLICENSED",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:push:dev": "prisma db push",
    "prisma:seed:demo": "ts-node prisma/seed.ts",
    "provision:admin": "ts-node src/cli/provision-admin.ts",
    "cleanup:idempotency": "ts-node src/cli/cleanup-idempotency.ts",
    "db:inspect": "ts-node src/cli/database-lifecycle.ts inspect",
    "db:snapshot": "ts-node src/cli/database-lifecycle.ts snapshot",
    "db:backup": "ts-node src/cli/database-lifecycle.ts backup",
    "db:verify-backup": "ts-node src/cli/database-lifecycle.ts verify-backup",
    "db:restore:staging": "ts-node src/cli/database-lifecycle.ts restore",
    "db:migrate:safe": "ts-node src/cli/database-lifecycle.ts migrate-safe",
    "db:reconcile": "ts-node src/cli/database-lifecycle.ts reconcile",
    "db:adopt:dry-run": "ts-node src/cli/prototype-adoption.ts dry-run",
    "db:adopt:execute": "ts-node src/cli/prototype-adoption.ts execute",
    "openapi:generate": "npm run build && node dist/cli/generate-openapi.js",
    "openapi:check": "npm run build && node dist/cli/generate-openapi.js --check",
    "prisma:studio": "prisma studio",
    "test": "jest --runInBand",
    "test:integration:db": "node scripts/run-db-integration-tests.mjs",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "prisma": "^7.10.0",
    "bcrypt": "6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "decimal.js": "^10.5.0",
    "dotenv": "^16.4.7",
    "helmet": "^8.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "cacheDirectory": "<rootDir>/../.jest-cache",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
