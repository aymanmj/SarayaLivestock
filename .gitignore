# ==============================================================================
# Saraya Livestock Enterprise ERP - Git Ignore Configuration
# ==============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js
.pnpm-store/
.yarn/cache/
.yarn/unplugged/

# Environment Variables & Secrets
.env
.env.*
!.env.example
!.env.production.example
deploy/.env.production
apps/*/.env*
!apps/*/.env.example

# Cryptographic Keys & Private Signing Material
/license-keys/*
!/license-keys/.gitkeep
*.key
*.pem
*.pfx
*.p12
!apps/api/src/modules/license/saraya-license-public.pem

# Testing & Code Coverage
coverage/
*.lcov
.nyc_output/
.jest-cache/

# Build & Compilation Outputs
dist/
build/
out/
.next/
installer-build/
/apps/desktop/web-dist/
/apps/desktop/dist-electron/
*.tsbuildinfo
.turbo/
.wireit/
.eslintcache

# Database Dumps, Snapshots & Local SQLite
backups/*
!backups/.gitkeep
*.dump
*.manifest.json
*.snapshot.json
*.db
*.db-journal
*.sqlite
*.sqlite3
prisma/*.db

# Logs & Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Operating System Files
.DS_Store
Thumbs.db
*.bak
*.tmp

# IDE & Editor Configurations
.vscode/
.idea/
*.swp
*.swo

