# Database
DATABASE_URL="postgresql://postgres:replace-with-a-strong-database-password@localhost:5432/saraya_livestock_db?schema=public"
DB_USER=postgres
DB_PASSWORD=replace-with-a-strong-database-password
DB_NAME=saraya_livestock_db
DB_PORT=5432
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000

# Database lifecycle guardrails (set explicitly only during an approved operation)
SARAYA_DB_ENV=development
# SARAYA_DB_CONFIRM=saraya_staging
# SARAYA_DB_WRITES_STOPPED=true
# SARAYA_DB_ALLOW_PRODUCTION=true
# SARAYA_DB_CHANGE_TICKET=CHG-0000
# RESTORE_DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/saraya_restore?schema=public
# RESTORE_DATABASE_NAME=saraya_restore
# MIGRATION_DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/saraya_staging?schema=public
# MIGRATION_DATABASE_NAME=saraya_staging
# ADOPTION_DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/saraya_adoption_staging?schema=public
# ADOPTION_DATABASE_NAME=saraya_adoption_staging
# SARAYA_ADOPTION_EXECUTE=true
# SARAYA_ADOPTION_NORMALIZE_PERIOD_BOUNDARIES=true
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\16\bin\pg_dump.exe
# PG_RESTORE_PATH=C:\Program Files\PostgreSQL\16\bin\pg_restore.exe

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT & Security
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRATION=15m
REFRESH_TOKEN_TTL_DAYS=30
IDEMPOTENCY_RETENTION_DAYS=7
ENCRYPTION_KEY=replace-with-at-least-32-random-characters
ALLOW_DEMO_SEED=false
DEMO_USER_PASSWORD=replace-only-when-explicitly-running-demo-seed
CORS_ORIGINS=http://localhost:3050,null
ENABLE_SWAGGER=false
TRUST_PROXY_HOPS=0
# SARAYA_DATA_DIR=C:\ProgramData\SarayaLivestock

# Customer-specific business values (zero means not configured; reports will not invent values)
MILK_PRICE_PER_LITER=0
BEEF_MARKET_PRICE_PER_KG=0

# One-time customer provisioning (remove the password after provisioning)
INITIAL_ORG_NAME=Your Organization
INITIAL_FARM_NAME=Your Farm
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_FULL_NAME=System Administrator
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-initial-password

# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
API_PREFIX=api/v1
