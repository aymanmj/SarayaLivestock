# Copy to a protected file outside source control and use with --env-file.
APP_VERSION=1.0.0

DB_USER=saraya
DB_PASSWORD=replace-with-a-long-random-database-password
DB_NAME=saraya_livestock_prod
DATABASE_URL=postgresql://saraya:replace-with-url-encoded-password@postgres:5432/saraya_livestock_prod?schema=public

JWT_SECRET=replace-with-64-random-characters
ENCRYPTION_KEY=replace-with-another-64-random-characters
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
REFRESH_TOKEN_TTL_DAYS=30
IDEMPOTENCY_RETENTION_DAYS=7

# Offline LAN mode (default): internal CA, no Internet required at runtime.
CADDYFILE=./deploy/caddy/Caddyfile.offline
SARAYA_OFFLINE_HOST=saraya.local
CORS_ORIGINS=https://saraya.local,null

# Public online mode: comment the three lines above and configure these.
# CADDYFILE=./deploy/caddy/Caddyfile.online
# SARAYA_DOMAIN=saraya.example.com
# ACME_EMAIL=ops@example.com
# CORS_ORIGINS=https://saraya.example.com,null

HTTP_PORT=80
HTTPS_PORT=443
MILK_PRICE_PER_LITER=0
BEEF_MARKET_PRICE_PER_KG=0

# Optional: the API starts read-only until a valid license is activated.
# SARAYA_LICENSE_KEY=SARAYA-LIC...
# VAULT_ADDR=https://vault.internal:8200
# VAULT_TOKEN=use-a-short-lived-or-agent-provided-token

# Supply only to an explicit db-ops maintenance command; keep false otherwise.
SARAYA_DB_WRITES_STOPPED=false
SARAYA_DB_ALLOW_PRODUCTION=false
SARAYA_DB_CHANGE_TICKET=
